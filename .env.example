# Copy to .env and fill in. .env is git-ignored; never commit it.
# The key is read only by the engine; the browser only ever sees short-lived client secrets.
OPENAI_API_KEY=

# Realtime models (verified against @openai/agents-realtime 0.21.0 and openai 7.47.0 types, 3 Nov 2026)
BENCHMATE_REALTIME_MODEL=gpt-realtime-2.1
BENCHMATE_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
# What a page without ?model= gets: mini (decided 4 Nov) or flagship
BENCHMATE_DEFAULT_MODEL=mini

# Engine
BENCHMATE_HOST=127.0.0.1
BENCHMATE_PORT=8000
BENCHMATE_DB=data/benchmate.sqlite

# Fake bench (until real hardware): meter read time in seconds, scenario, delay scale (0 = instant)
BENCHMATE_DUMMY_DELAY_S=1.5
# short_battery_line | no_current | not_charging | glare_low_confidence | conflicting_reading |
# camera_unavailable | vision_timeout   (switchable from the page's dev controls; ?scenario= too)
BENCHMATE_FAKE_SCENARIO=short_battery_line
BENCHMATE_FAKE_TIME_SCALE=1
# Hard timeout for one camera read; on timeout the agent asks the user to read the value aloud
BENCHMATE_VISION_TIMEOUT_S=4
# GET /dev/sessions/{id} and the scenario list (the engine binds to 127.0.0.1); 0 turns them off
BENCHMATE_DEV_ENDPOINTS=1

# Lifetime of a secret minted on demand (10-7200 s; it only needs to outlive the connect)
BENCHMATE_CLIENT_SECRET_TTL_S=120
# Pre-minted secrets (one per session config) so a page load does not wait for OpenAI; 0 turns the pool off
BENCHMATE_SECRET_POOL=1
BENCHMATE_POOL_SECRET_TTL_S=600

# Turn detection: semantic_medium | semantic_high | server_300 | server_400 | server_500 | ptt
# (switchable live from the page's dev controls; ?turn_mode= in the URL also works).
# Push-to-talk is the default (decided 4 Nov): hold the talk key (default Space; set on the page)
BENCHMATE_TURN_MODE=ptt
# Prompt: v0 | v1 | v1_local | v2 | v2_local | v3 | v3_local (the *_local ones play the pre-recorded
# preamble clip). v3 is the Phase 2 prompt for the 8 tools; v0-v2 know only get_reading.
BENCHMATE_PROMPT=v3_local
# Output cap per response, safety net only: 220 tokens is about 8 s of speech. 0 or inf = no cap
BENCHMATE_MAX_OUTPUT_TOKENS=220
